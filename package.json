{
  "name": "ollama-profiler",
  "version": "0.1.0",
  "description": "Cross-platform desktop profiler for fleets of Ollama servers",
  "author": "Ollama Profiler contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "node scripts/version.cjs --write",
    "predev": "node scripts/version.cjs --write",
    "dev": "electron-vite dev",
    "predev:stitch": "node scripts/version.cjs --write",
    "dev:stitch": "vite --config vite.stitch.config.ts",
    "prebuild": "node scripts/version.cjs --write",
    "build": "electron-vite build",
    "pretypecheck": "node scripts/version.cjs --write",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest": "node scripts/version.cjs --write",
    "test": "vitest run",
    "pretest:watch": "node scripts/version.cjs --write",
    "test:watch": "vitest",
    "dist": "npm run build && node scripts/package.cjs",
    "dist:dir": "npm run build && node scripts/package.cjs --dir",
    "version:current": "node scripts/version.cjs",
    "version:check-tag": "node scripts/version.cjs --check-tag"
  },
  "dependencies": {
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.ollamaprofiler.desktop",
    "productName": "Ollama Profiler",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
