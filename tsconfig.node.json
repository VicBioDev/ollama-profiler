{
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
